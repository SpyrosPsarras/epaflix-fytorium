#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────────────────
# STAGES: Firebase project for Fytorium Android push (epaflix-fytorium#34)
# ──────────────────────────────────────────────────────────────────────────
TOTAL_STAGES=6
ENV_FILE=/dev/null
REPO=SpyrosPsarras/epaflix-fytorium
PKG=com.epaflix.fytorium
VAULT_PATH="/Fytorium/fytorium - firebase"

hub() { # JSON enters on stdin, never argv. The hub credential comes from the desktop keyring.
  python3 -c '
import json, subprocess, sys, urllib.request
try:
    token = subprocess.check_output(["secret-tool", "lookup", "service", "mcp-hub", "key", "api"], stderr=subprocess.DEVNULL).decode().strip()
    if not token: raise ValueError()
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": sys.argv[1], "arguments": json.load(sys.stdin)}}
    req = urllib.request.Request("https://mcp.epaflix.com/vaultwarden", data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "Accept": "application/json, text/event-stream"})
    out = json.load(urllib.request.urlopen(req, timeout=60))
    if out.get("error") or (out.get("result") or {}).get("isError"): raise ValueError()
except Exception:
    sys.exit("Vaultwarden write failed. Unlock the login keyring and check the hub connection.")
' "$1"
}
STORED=false
SOPS_DONE=false

banner "Firebase for Fytorium Android push"

stage "Create the Firebase project"
open_url "https://console.firebase.google.com/"
step "Click 'Create a project' (or 'Add project')."
step "Name it: fytorium. Accept the terms."
step "Turn OFF Google Analytics for this project, then create it."
note "Firebase changes its wording now and then; pick the closest match."
ask FIREBASE_PROJECT_ID "Project ID shown under the project name (e.g. fytorium-1a2b3):"
[[ -n "$FIREBASE_PROJECT_ID" ]] || { warn "A project ID is required."; exit 1; }

stage "Add the Android app and download google-services.json"
open_url "https://console.firebase.google.com/project/${FIREBASE_PROJECT_ID}/overview"
step "Click the Android icon ('Add app' → Android)."
step "Android package name: ${PKG}"
step "App nickname: Fytorium. Leave the SHA-1 field empty."
step "Click 'Register app', then 'Download google-services.json'."
step "Skip the remaining SDK steps ('Next' until 'Continue to console')."
ask GS_PATH "Path to the downloaded google-services.json [~/Downloads/google-services.json]:"
GS_PATH="${GS_PATH:-$HOME/Downloads/google-services.json}"; GS_PATH="${GS_PATH/#\~/$HOME}"
python3 - "$GS_PATH" "$PKG" "$FIREBASE_PROJECT_ID" <<'PY' || { warn "That file doesn't look right; re-run this wizard."; exit 1; }
import json, sys
d = json.load(open(sys.argv[1]))
assert d["project_info"]["project_id"] == sys.argv[3], "project id differs"
assert any(c["client_info"]["android_client_info"]["package_name"] == sys.argv[2] for c in d["client"]), "package missing"
print("  google-services.json OK")
PY

stage "Check the Cloud Messaging API and create the server key"
open_url "https://console.firebase.google.com/project/${FIREBASE_PROJECT_ID}/settings/cloudmessaging"
step "On 'Cloud Messaging', 'Firebase Cloud Messaging API (V1)' must say Enabled."
step "If it doesn't, use its ⋮ menu → 'Manage API in Google Cloud Console' → Enable."
pause "Press Enter when V1 shows Enabled."
open_url "https://console.firebase.google.com/project/${FIREBASE_PROJECT_ID}/settings/serviceaccounts/adminsdk"
step "On 'Service accounts' → 'Firebase Admin SDK', click 'Generate new private key' → 'Generate key'."
warn "This file is a secret. The wizard stores it and then deletes the download."
ask SA_PATH "Path to the downloaded service account JSON (in ~/Downloads, name starts with ${FIREBASE_PROJECT_ID}):"
SA_PATH="${SA_PATH/#\~/$HOME}"
python3 - "$SA_PATH" "$FIREBASE_PROJECT_ID" <<'PY' || { warn "That file doesn't look like the service account key; re-run."; exit 1; }
import json, sys
d = json.load(open(sys.argv[1]))
assert d.get("type") == "service_account" and d.get("project_id") == sys.argv[2] and d.get("private_key")
print("  service account key OK")
PY

stage "Store both files in Vaultwarden and GitHub"
say "Vaultwarden item: ${VAULT_PATH} (both files as attachments)."
say "GitHub secret on ${REPO}: GOOGLE_SERVICES_JSON (raw JSON, not base64)."
if confirm "Store them now?"; then
  python3 -c 'import json,sys; print(json.dumps({"path": sys.argv[1], "username": sys.argv[2], "url": "https://console.firebase.google.com/project/"+sys.argv[2], "notes": "Firebase project for Fytorium Android push. Attachments: google-services.json (app config, also GitHub secret GOOGLE_SERVICES_JSON on SpyrosPsarras/epaflix-fytorium) and fcm-service-account.json (server FCM key; SOPS in 2-k3s/25.fytorium)."}))' "$VAULT_PATH" "$FIREBASE_PROJECT_ID" | hub vault_add || { warn "Vaultwarden item was not saved. Downloads retained."; exit 1; }
  printf '  %s✓ created%s %s\n' "$GREEN" "$RESET" "$VAULT_PATH"
  for pair in "google-services.json:$GS_PATH" "fcm-service-account.json:$SA_PATH"; do
    python3 -c 'import base64,json,sys; print(json.dumps({"path": sys.argv[1], "filename": sys.argv[2], "content_b64": base64.b64encode(open(sys.argv[3],"rb").read()).decode()}))' "$VAULT_PATH" "${pair%%:*}" "${pair#*:}" | hub vault_attach || { warn "Vaultwarden attachment was not saved. Downloads retained."; exit 1; }
    printf '  %s✓ attached%s %s\n' "$GREEN" "$RESET" "${pair%%:*}"
  done
  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    gh secret set GOOGLE_SERVICES_JSON -R "$REPO" < "$GS_PATH" >/dev/null 2>&1 || { warn "GitHub secret was not saved. Downloads retained."; exit 1; }
    WRITTEN_SECRET+=(GOOGLE_SERVICES_JSON)
    printf '  %s✓ set%s GitHub secret GOOGLE_SERVICES_JSON\n' "$GREEN" "$RESET"
  else SKIPPED+=("GitHub secret GOOGLE_SERVICES_JSON"); fi
  STORED=true
fi

stage "Store the server key in homelab SOPS"
say "Do this before deleting the downloaded service account key. No deployment runs here."
ask HOMELAB_REPO "Absolute path to the homelab checkout:"
ask SOPS_FILE "Path to its existing encrypted Fytorium Kubernetes Secret, relative to that checkout (under 2-k3s/25.fytorium):"
[[ -d "$HOMELAB_REPO" && -f "$HOMELAB_REPO/$SOPS_FILE" ]] || { warn "Choose an existing homelab checkout and encrypted Secret."; exit 1; }
say "In a separate terminal, run:"
printf '    cd %q && sops-kpx %q\n' "$HOMELAB_REPO" "$SOPS_FILE"
step "In that editor add stringData.FCM_SERVICE_ACCOUNT_JSON as a YAML literal block containing the service account download, including its JSON braces."
step "Add stringData.FCM_PROJECT_ID with the project ID selected in stage 1. Save and close. Only the encrypted Secret may be committed."
step "In the Fytorium Deployment, set FCM_SERVICE_ACCOUNT_JSON and FCM_PROJECT_ID using valueFrom.secretKeyRef to those keys in that Secret."
step "Leave FCM_BASE_URL and FCM_OAUTH_TOKEN_URL unset in production. Their defaults are Google HTTP v1 and OAuth."
note "Alternatively mount the decrypted JSON as a Secret file and set FCM_SERVICE_ACCOUNT_FILE to its absolute container path."
if confirm "Have you saved both values in SOPS?"; then SOPS_DONE=true
else SKIPPED+=("Homelab SOPS: follow the exact instructions above before deleting the service account download."); fi

stage "Delete the downloaded files"
say "Delete downloads only after confirming Vaultwarden and SOPS are saved."
if [[ "$STORED" == true && "$SOPS_DONE" == true ]] && confirm "Delete ${GS_PATH} and ${SA_PATH}?"; then
  shred -u "$SA_PATH" 2>/dev/null || rm -f "$SA_PATH"; rm -f "$GS_PATH"
  printf '  %s✓ deleted%s\n' "$GREEN" "$RESET"
fi
say "Tell the agent: Firebase done, project ${FIREBASE_PROJECT_ID}."
pause

finish
