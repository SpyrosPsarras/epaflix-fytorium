#!/bin/sh
# usage: e2e/run w1. Runs inside the emulator image on the stack network, from mobile/.
set -eu
scenario=${1:?scenario}
artifacts=/src/cache/artifacts/e2e
mkdir -p "$artifacts"
. e2e/device
package=com.epaflix.fytorium
pass() { echo "PASS: $*"; }
fail() { echo "FAIL: $*" >&2; adb logcat -d > "$artifacts/logcat.txt" 2>/dev/null || true; grep -A25 "FATAL EXCEPTION" "$artifacts/logcat.txt" | head -60 >&2 || true; adb exec-out screencap -p > "$artifacts/failure.png" 2>/dev/null || true; adb shell uiautomator dump /sdcard/window.xml >/dev/null 2>&1 && adb pull /sdcard/window.xml "$artifacts/failure-window.xml" >/dev/null 2>&1 || true; exit 1; }
in_app() { adb shell run-as "$package" "$@"; }
launch_without_crash() {
  adb logcat -c
  adb shell am start -W -n "$package/.MainActivity" >/dev/null
  sleep 8
  adb shell pidof "$package" >/dev/null || fail "$1: process not running"
  adb shell uiautomator dump /sdcard/window.xml >/dev/null && adb pull /sdcard/window.xml /tmp/window.xml >/dev/null
  grep -q 'text="Fytorium"' /tmp/window.xml || fail "$1: Fytorium screen not shown"
  ! adb logcat -d | grep -E "FATAL EXCEPTION|Force finishing activity.*$package" || fail "$1: crashed"
  pass "$1: launched without Metro and without a crash"
}
w1() {
  for host in gbif fakes; do
    if curl -fsS "http://$host:8080/__admin/mappings" >/tmp/mappings 2>/dev/null; then break; fi
  done
  [ "$(grep -o '"id"' /tmp/mappings | wc -l)" -gt 0 ] || fail 'WireMock sees no mounted mappings'
  curl -fsS http://fake-push:8080/fcm/stats >/dev/null || fail 'fake-push not serving its mounted script'
  pass 'Stack fakes see their mounted files'

  fixture=/src/cache/kotlin-fixture
  push_id="synthetic-fcm-w1-$(cat /proc/sys/kernel/random/uuid)"
  adb install "$fixture/app.apk" >/dev/null && adb install "$fixture/test.apk" >/dev/null
  curl -fsS -H 'Content-Type: application/json' -d '{"action":"set","at":"2030-06-01T10:00:00Z"}' http://app:3000/__test/clock >/dev/null
  adb shell am instrument -w -e class com.epaflix.fytorium.SeedTest -e pushToken "$push_id" -e denyNotifications true \
    "$package.test/androidx.test.runner.AndroidJUnitRunner" > "$artifacts/seed.txt" || true
  grep -q '^OK (1 test)' "$artifacts/seed.txt" || { cat "$artifacts/seed.txt" >&2; fail 'Kotlin seed did not complete'; }
  in_app ls shared_prefs databases | tee "$artifacts/kotlin-files.txt" | grep -q credentials.xml || fail 'seeded install has no credentials'
  pass "Kotlin $fixture/app.apk seeded: logged in, Today and a plant cached, token registered"

  adb install -r /src/cache/artifacts/fytorium-release-fixture.apk >/dev/null || fail 'release fixture APK did not install over the Kotlin app'
  launch_without_crash 'Release fixture over Kotlin'
  adb install -r /src/cache/artifacts/fytorium-debug-fixture.apk >/dev/null || fail 'debug fixture APK did not install over the release fixture'
  launch_without_crash 'Debug fixture'
  in_app cat shared_prefs/fytorium-platform.xml > /tmp/flags.xml
  for flag in first_run_done push_reset_pending notifications_asked; do
    grep -q "name=\"$flag\" value=\"true\"" /tmp/flags.xml || fail "N5 did not set $flag"
  done
  for path in shared_prefs/credentials.xml shared_prefs/diagnostics.xml shared_prefs/notification-permission.xml \
    databases/care-cache.db cache/thumbnails cache/captures no_backup/photo-drafts; do
    ! in_app ls "$path" >/dev/null 2>&1 || fail "N5 left $path"
  done
  in_app cat no_backup/androidx.work.workdb > /tmp/work.db || fail "WorkManager database missing"
  for wal in -wal -shm; do in_app cat "no_backup/androidx.work.workdb$wal" > "/tmp/work.db$wal" 2>/dev/null || rm -f "/tmp/work.db$wal"; done
  live=$(sqlite3 /tmp/work.db "SELECT count(*) FROM workname JOIN workspec ON workspec.id = workname.work_spec_id WHERE workname.name IN ('care-cache-refresh','notification-cache-refresh') AND workspec.state NOT IN (2,3,5)")
  [ "$live" = 0 ] || fail 'N5 left legacy WorkManager jobs scheduled'
  cancelled=$(sqlite3 /tmp/work.db "SELECT count(*) FROM workname JOIN workspec ON workspec.id = workname.work_spec_id WHERE workname.name = 'care-cache-refresh' AND workspec.state = 5")
  [ "$cancelled" -ge 1 ] || fail "the seeded care-cache-refresh job was not found cancelled"

  pass 'N5 removed legacy prefs, database, caches, drafts and jobs; set the reset flag; carried over the asked flag'

  adb shell pm grant "$package" android.permission.POST_NOTIFICATIONS
  push() { adb shell am broadcast -n "$package/com.epaflix.fytorium.platform.DebugPushReceiver" -a com.epaflix.fytorium.DEBUG_PUSH \
    --es tag fytorium-daily --es title "'$1'" --es body "'$2'" --es url / >/dev/null; sleep 2; }
  posted() { adb shell dumpsys notification --noredact | grep -c "pkg=$package.*tag=fytorium-daily" || true; }
  push 'Synthetic reminder one' 'Synthetic body one'
  [ "$(posted)" = 0 ] || fail 'N4 showed a push while push_ready was clear'
  adb shell am force-stop "$package"
  printf '%s\n' "<?xml version='1.0' encoding='utf-8' standalone='yes' ?>" '<map>' \
    '<boolean name="first_run_done" value="true" />' '<boolean name="push_ready" value="true" />' '</map>' \
    | adb shell "run-as $package sh -c 'cat > /data/data/$package/shared_prefs/fytorium-platform.xml'"
  push 'Synthetic reminder one' 'Synthetic body one'
  [ "$(posted)" = 1 ] || fail 'N4 did not show a push once push_ready was set'
  push 'Synthetic reminder two' 'Synthetic body two'
  [ "$(posted)" = 1 ] || fail 'N4 did not replace the notification by tag'
  adb shell dumpsys notification --noredact | grep -q 'Synthetic reminder two' || fail 'replacement text not shown'
  pass 'N4: dropped while push_ready clear, shown once set, replaced by tag'
}
"$scenario"
echo "E2E $scenario PASS"
