#!/bin/sh
set -eu
cd "$(dirname "$0")"
temp=$(mktemp -d)
trap 'rm -rf "$temp"' EXIT
for url in https://app https://oidc https://fake-push http://app:3000 https://oidc/default https://fake-push. '"https://app"'; do
  printf 'x\000%s\000y' "$url" > "$temp/dex"
  if sh test-hosts "$temp/dex"; then echo "Missed test host: $url" >&2; exit 1; fi
done
for url in https://fytorium.epaflix.com https://application.example http://localhost:8081/ https://oidcx.example; do
  printf 'x\000%s\000y' "$url" > "$temp/dex"
  sh test-hosts "$temp/dex" || { echo "Flagged production string: $url" >&2; exit 1; }
done
echo 'Test-host scan checks passed: NUL, colon, slash, quote and trailing-dot terminators.'
