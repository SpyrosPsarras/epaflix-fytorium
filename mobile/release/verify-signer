#!/bin/sh
# usage: verify-signer <apk> <expected SHA-256 fingerprint>
set -eu
tools=$(ls -d /opt/android/build-tools/* | tail -n 1)
certs=$("$tools/apksigner" verify --verbose --print-certs "$1")
printf '%s\n' "$certs"
# apksigner names the signer "Signer #1" or, for v3-only APKs, "V3.0 Signer"; every listed signer must be the same certificate.
actual=$(printf '%s\n' "$certs" | grep -E '^(Signer #1|V[0-9.]+ Signer):? certificate SHA-256 digest:' | sed 's/.*digest://' | tr -d ' :\r' | tr '[:lower:]' '[:upper:]' | sort -u)
expected=$(printf '%s' "$2" | tr -d ':' | tr '[:lower:]' '[:upper:]')
if [ "$actual" != "$expected" ] || ! printf '%s\n' "$certs" | grep -q '^Number of signers: 1$'; then
  echo 'APK signing certificate does not match the expected SHA-256 fingerprint.' >&2
  exit 1
fi
