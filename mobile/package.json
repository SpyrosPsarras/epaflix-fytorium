{
  "name": "fytorium-mobile",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-image-picker",
          "expo-background-task",
          "expo-task-manager"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/\\.cache/",
      "/helpers/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^27.2.0",
    "@react-native-firebase/messaging": "^27.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-image": "~58.0.19",
    "expo-localization": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  }
}
