{
  "name": "fytorium-mobile",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-image-picker"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/\\.cache/"
    ]
  },
  "dependencies": {
    "@react-native-firebase/app": "^27.2.0",
    "@react-native-firebase/messaging": "^27.2.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  }
}
