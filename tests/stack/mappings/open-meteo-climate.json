{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/v1/climate",
    "queryParameters": {
      "start_date": {
        "equalTo": "1991-01-01"
      },
      "end_date": {
        "equalTo": "2020-12-31"
      },
      "models": {
        "equalTo": "CMCC_CM2_VHR4"
      },
      "daily": {
        "equalTo": "temperature_2m_min"
      }
    },
    "headers": {
      "Host": {
        "matches": "open-meteo-climate(:[0-9]+)?"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "daily": {
        "time": [
          "2000-01-01",
          "2000-02-01",
          "2000-03-01",
          "2000-04-01",
          "2000-05-01",
          "2000-06-01",
          "2000-07-01",
          "2000-08-01",
          "2000-09-01",
          "2000-10-01",
          "2000-11-01",
          "2000-12-01"
        ],
        "temperature_2m_min": [
          -5,
          -3,
          2,
          6,
          10,
          15,
          18,
          17,
          12,
          7,
          1,
          -4
        ]
      }
    }
  }
}
