    "@playwright/test": "1.58.2",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testcontainers/postgresql": "^11.7.2",
